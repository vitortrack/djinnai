{
  "name": "@vitortrack777/detro",
  "version": "0.1.22",
  "description": "detro: tela web local para conversar com o agente do Claude Code (Claude ou modelos do Ollama) e rodar os comandos do ambiente do projeto.",
  "type": "module",
  "bin": {
    "detro": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node web/src/lib/markdown.test.js",
    "build": "vite build --config web/vite.config.js",
    "prepublishOnly": "npm run build",
    "setup": "bash ./detro.sh install",
    "update": "bash ./detro.sh update",
    "uninstall-cli": "bash ./detro.sh uninstall"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "server.js",
    "web/dist/",
    "detro.sh",
    "detro-completion.bash",
    "LICENSE"
  ],
  "keywords": [
    "detro",
    "cli",
    "ai",
    "claude",
    "claude-code",
    "ollama",
    "agent"
  ],
  "author": "vitortrack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitortrack/detro-cli.git"
  },
  "homepage": "https://github.com/vitortrack/detro-cli#readme",
  "bugs": {
    "url": "https://github.com/vitortrack/detro-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@vitejs/plugin-react": "^4.7.0",
    "marked": "^15.0.12",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5"
  }
}
