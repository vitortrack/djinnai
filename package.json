{
  "name": "@vitortrack777/djinnai",
  "version": "0.7.0",
  "description": "DjinnAI: aplicativo local para conversar com o agente do Claude Code (Claude ou modelos do Ollama) e rodar os comandos do ambiente do projeto.",
  "type": "module",
  "bin": {
    "djinn": "./index.js",
    "djinnai": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node web/src/lib/markdown.test.js && node web/src/lib/turns.test.js && node web/src/lib/limits.test.js",
    "build": "vite build --config web/vite.config.js",
    "prepublishOnly": "npm run build",
    "setup": "bash ./djinn.sh install",
    "update": "bash ./djinn.sh update",
    "uninstall-cli": "bash ./djinn.sh uninstall"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "index.js",
    "server.js",
    "window.cjs",
    "web/dist/",
    "djinn.sh",
    "djinn-completion.bash",
    "LICENSE"
  ],
  "keywords": [
    "djinnai",
    "djinn",
    "cli",
    "ai",
    "claude",
    "claude-code",
    "ollama",
    "agent"
  ],
  "author": "vitortrack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitortrack/djinnai.git"
  },
  "homepage": "https://github.com/vitortrack/djinnai#readme",
  "bugs": {
    "url": "https://github.com/vitortrack/djinnai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@vitejs/plugin-react": "^4.7.0",
    "marked": "^15.0.12",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "electron": "44.7.1"
  }
}
